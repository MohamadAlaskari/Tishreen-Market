# ── Tishreen — environment variables (copy to .env locally; never commit .env) ──
# Database
DB_URL=jdbc:postgresql://localhost:5432/tishreen
DB_USERNAME=tishreen
DB_PASSWORD=change-me
# Auth (generate with: openssl rand -base64 48)
JWT_SECRET=change-me-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-different-from-access-secret
OTP_PEPPER=change-me-used-when-hashing-otp-codes
# Storage provider "local-disk" (default) — or MinIO when settings.storage.provider = minio
MEDIA_BASE_PATH=/var/tishreen/media
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=tishreen-media
# Backups / logs
BACKUP_DIR=/var/tishreen/backups
LOG_DIR=/var/tishreen/logs
# Web
VITE_API_BASE=/api/v1
WEB_ORIGIN=http://localhost:3000
# Spring profile: dev | prod  (dev also applies db/dev seed with the Tishreen!Dev1 accounts)
SPRING_PROFILES_ACTIVE=dev
