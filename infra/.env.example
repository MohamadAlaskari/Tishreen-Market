# Local dev environment for infra/docker-compose.yml.
# Copy to infra/.env and adjust; .env is git-ignored and must never be committed.
POSTGRES_DB=tishreen
POSTGRES_USER=tishreen
POSTGRES_PASSWORD=tishreen
POSTGRES_PORT=5432

# Ports per operating mode for tishreen.ps1 (defaults shown; the script falls
# back to them when a value is missing). The DEV values must match the project
# config: api application.yml uses 8080, apps/web package.json pins 3000.
DEV_API_PORT=8080
DEV_WEB_PORT=3000
NEARPROD_API_PORT=8180
NEARPROD_WEB_PORT=3100
PROD_API_PORT=8280
PROD_WEB_PORT=3200
