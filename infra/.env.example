# Local dev environment for infra/compose.base.yml plus the per-mode overlays
# (compose.dev.yml / compose.nearprod.yml / compose.prod.yml).
# Copy to infra/.env and adjust; .env is git-ignored and must never be committed.
POSTGRES_DB=tishreen
POSTGRES_USER=tishreen
POSTGRES_PASSWORD=tishreen

# Ports per operating mode for tishreen.ps1 (defaults shown; the script and
# the compose files fall back to them when a value is missing). Every mode has
# its own database. The DEV API/web values must match the project config:
# api application.yml uses 8080, apps/web package.json pins 3000.
DEV_POSTGRES_PORT=5432
DEV_API_PORT=8080
DEV_WEB_PORT=3000
NEARPROD_POSTGRES_PORT=5532
NEARPROD_API_PORT=8180
NEARPROD_WEB_PORT=3100
PROD_POSTGRES_PORT=5632
PROD_API_PORT=8280
PROD_WEB_PORT=3200
